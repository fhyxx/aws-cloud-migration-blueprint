#!/bin/bash
set -euo pipefail

dnf install -y python3
install -d -m 0755 /opt/clafoke-app

cat >/opt/clafoke-app/server.py <<'PY'
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import json
import os

class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == "/health/ready":
            payload = {"status": "ok", "service": "clafoke-order-api"}
        elif self.path == "/api/v1/orders":
            payload = {
                "items": [
                    {"id": "ORD-1001", "status": "processing", "total": 24500},
                    {"id": "ORD-1002", "status": "ready", "total": 12750}
                ],
                "mode": "synthetic-demo"
            }
        else:
            payload = {"service": "clafoke-order-api", "message": "Synthetic portfolio API"}

        body = json.dumps(payload).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, fmt, *args):
        print("%s - %s" % (self.address_string(), fmt % args))

port = int(os.environ.get("APP_PORT", "${app_port}"))
ThreadingHTTPServer(("0.0.0.0", port), Handler).serve_forever()
PY

cat >/etc/systemd/system/clafoke-api.service <<'UNIT'
[Unit]
Description=Clafoke synthetic order API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=APP_PORT=${app_port}
ExecStart=/usr/bin/python3 /opt/clafoke-app/server.py
Restart=always
RestartSec=5
User=nobody
Group=nobody

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now clafoke-api
