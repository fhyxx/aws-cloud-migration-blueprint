flowchart TB
  USERS[Approved users] --> DNS[Public DNS<br/>Route 53 if authoritative]
  DNS --> ALB[Internet-facing ALB<br/>HTTPS 443 + ACM certificate]

  subgraph ONPREM["Illustrative on-premises source<br/>10.50.0.0/16 • app 10.50.10.0/24 • DB/NFS 10.50.20.0/24"]
    APP_SRC[Two Linux application VMs<br/>MGN sources]
    PG_SRC[(Self-managed PostgreSQL source)]
    NFS_SRC[(NFS file server)]
    ARCH_SRC[Archive source<br/>location and type TBD]
    DS_AGENT["DataSync agent VM<br/>10.50.20.50/32<br/>VPC endpoint mode"]
    NFS_SRC -->|NFS TCP 2049 or 111 + 2049| DS_AGENT
    ARCH_SRC -.->|archive source/agent path TBD| DS_AGENT
  end

  MGN_SVC[AWS MGN regional service API]
  DS[AWS DataSync service]

  subgraph VPC["AWS VPC 10.30.0.0/16 — us-east-1 — two AZs"]
    IGW[Internet Gateway]
    VGW["Virtual Private Gateway<br/>BGP ASN 64512"]
    subgraph PUB["Public subnets A/B"]
      ALB[Internet-facing ALB nodes in public subnets A/B<br/>HTTPS 443 + ACM]
      NAT_A[NAT Gateway A]
      NAT_B[NAT Gateway B]
    end
    subgraph APP["Private application subnets A/B"]
      ASG[Application Auto Scaling Group<br/>desired capacity 2]
      EC2_A[EC2 app A<br/>4 vCPU / 16 GiB]
      EC2_B[EC2 app B<br/>4 vCPU / 16 GiB]
      ASG --> EC2_A
      ASG --> EC2_B
    end
    subgraph DMS_MIGRATION["Private DMS migration subnets A/B<br/>10.30.41.0/24 • 10.30.42.0/24"]
      DMS[DMS replication instance or Serverless<br/>dedicated DMS security group<br/>source route via VGW; service egress via same-AZ NAT]
    end
    subgraph DB["Isolated DB subnets A/B"]
      RDS[(RDS PostgreSQL<br/>Multi-AZ DB instance deployment<br/>500 GB configured storage input)]
    end
    subgraph MGN_STAGING["Private MGN staging-area subnet<br/>10.30.31.0/24 • AZ-A • migration-only"]
      MGN_REPL[MGN replication servers]
      MGN_EGRESS[Controlled TCP 443 egress<br/>same-AZ NAT or validated private endpoint]
      MGN_REPL --> MGN_EGRESS
    end
    subgraph DATASYNC_ENDPOINT_SUBNET["DataSync VPC endpoint subnet<br/>10.30.51.0/24 • AZ-A"]
      DS_VPCE["DataSync VPC service endpoint<br/>TCP 1024–1064 from agent"]
    end
    subgraph DATASYNC_TASK_SUBNET["DataSync task ENI subnet<br/>10.30.52.0/24 • AZ-A"]
      DS_ENI[DataSync task ENI<br/>TCP 443 from agent]
    end
    EFS[(Regional EFS<br/>1 TB assumption<br/>mount target in each app AZ)]
    DS_ENI[DataSync task ENI<br/>in same VPC and AZ as selected EFS mount target]
    S3EP[S3 Gateway Endpoint]
    S3[(S3 archive target<br/>500 GB capacity assumption)]
    CW[CloudWatch]
    OPS[Systems Manager / Secrets Manager]

    IGW --> ALB
    ALB --> EC2_A
    ALB --> EC2_B
    EC2_A --> RDS
    EC2_B --> RDS
    EC2_A --> EFS
    EC2_B --> EFS
    EC2_A --> S3EP
    EC2_B --> S3EP
    S3EP --> S3
    EC2_A --> CW
    EC2_B --> CW
    EC2_A --> OPS
    EC2_B --> OPS
    EC2_A --> NAT_A
    EC2_B --> NAT_B
    DMS -->|TCP 5432| RDS
    MGN_EGRESS -->|TCP 443| MGN_SVC
  end

  APP_SRC -->|MGN replication stream<br/>TCP 1500 over approved VPN route| MGN_REPL
  APP_SRC -->|MGN service access<br/>TCP 443 via approved egress| MGN_SVC
  DMS -->|Initiates PostgreSQL source connection<br/>TCP 5432 over VPN| PG_SRC
  DS_AGENT -->|TCP 1024–1064 control plane| DS_VPCE
  DS_AGENT -->|TCP 443 task data plane| DS_ENI
  DS_VPCE --> DS
  DS -->|Task orchestration| DS_ENI
  DS -->|Creates task data-plane ENI| DS_ENI
  DS_ENI -->|NFS TCP 2049| EFS
  DS -->|S3 service-side transfer| S3
  VGW ---|BGP 10.50.0.0/16 propagated only to DMS-A/DMS-B, MGN staging, DataSync endpoint and task subnets| DMS_MIGRATION
  VGW ---|BGP source route • TCP 1500 to staging<br/>two tunnels • no VGW ECMP| MGN_STAGING
  VGW ---|BGP source route only; no default route| DATASYNC_ENDPOINT_SUBNET
  VGW ---|BGP source route only; no default route| DATASYNC_TASK_SUBNET
